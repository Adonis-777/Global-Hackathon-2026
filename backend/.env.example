# Copy to backend/.env and fill in to send real SMS/WhatsApp via Twilio.
# Leave unset to run in dry-run mode (alerts are logged, not sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
